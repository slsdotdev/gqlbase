{
  "name": "@gqlbase/example",
  "description": "Example project for gqlbase, demonstrating how to use the core library and CLI to transform GraphQL schemas.",
  "version": "0.0.1",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "codegen": "gqlbase",
    "watch": "gqlbase --watch",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
    "typecheck": "gqlbase && tsc --noEmit",
    "test": "npm run typecheck && vitest run"
  },
  "dependencies": {
    "@dsqlbase/core": "^0.2.0",
    "@dsqlbase/migration": "^0.2.0",
    "@electric-sql/pglite": "^0.4.6",
    "@middy-appsync/graphql": "^0.1.5",
    "dsqlbase": "^0.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gqlbase/cli": "^0.1.11",
    "@gqlbase/plugins": "^0.1.11",
    "@types/aws-lambda": "^8.10.164",
    "graphql": "^16.14.2",
    "tsx": "^4.23.15",
    "vitest": "^4.1.6"
  }
}
