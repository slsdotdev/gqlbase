{
  "name": "@gqlbase/core",
  "description": "Core library for gqlbase, providing the GraphQL transformer and plugin system.",
  "version": "0.2.0",
  "sideEffects": false,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "sls.dev",
    "email": "dev@sls.dev",
    "url": "https://www.sls.dev"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://www.sls.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slsdotdev/gqlbase.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/slsdotdev/gqlbase/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"for (const p of ['dist', 'tsconfig.tsbuildinfo']) fs.rmSync(p, { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@gqlbase/shared": "^0.2.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "graphql": "^16.8.1"
  }
}
