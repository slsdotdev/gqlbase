{
  "name": "@gqlbase/cli",
  "description": "Command-line interface for gqlbase, providing tools for schema transformation and development workflow",
  "version": "0.2.1",
  "sideEffects": false,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "sls.dev",
    "email": "dev@sls.dev",
    "url": "https://www.sls.dev"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://www.sls.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slsdotdev/gqlbase.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/slsdotdev/gqlbase/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "gqlbase": "./bin/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"for (const p of ['dist', 'tsconfig.tsbuildinfo']) fs.rmSync(p, { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@gqlbase/core": "^0.2.1",
    "@gqlbase/shared": "^0.2.1",
    "cac": "^7.0.0",
    "chokidar": "^5.0.0",
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@gqlbase/plugins": "^0.2.1",
    "@types/picomatch": "^4.0.3"
  }
}
